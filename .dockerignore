# Keep the build context small and avoid baking secrets/dev-only state into the image.
# Runtime state (ciel_data, agent_output, ciel_workspace) is volume-mounted by
# docker-compose.yml, not copied in — excluding it here just speeds up the build;
# it does not affect what the running container sees.

.git/
.github/
.claude/
.agents/
myenv/
__pycache__/
**/__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/
.idea/

ciel_data/
agent_output/
ciel_workspace/
backtest/logs/
# The Dockerfile's dashboard stage builds ciel_app for the web; it needs lib/, web/
# and pubspec.*, not local caches, native platform folders, or tests.
ciel_app/build/
ciel_app/.dart_tool/
ciel_app/android/
ciel_app/ios/
ciel_app/macos/
ciel_app/windows/
ciel_app/linux/
ciel_app/test/
ciel_app/test_live/
web/
docker/tunnel.env

.env
credentials.json
*.log

docs/
note.md
architect.md
PROMPT_INVENTORY.md
