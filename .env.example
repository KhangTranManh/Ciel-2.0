# Ciel 2.0 minimal configuration
# Copy this file to .env, then replace every REQUIRED value. Never commit .env.

# REQUIRED: standard two-model topology through one OpenAI-compatible endpoint.
BRAIN_PROVIDER=custom
BRAIN_MODEL=replace-with-brain-model
WORKER_PROVIDER=custom
CODER_MODEL=replace-with-worker-model
API_KEY=replace-with-provider-key
BASE_URL=https://provider.example/v1

# Safe defaults. CODER_MODEL is the Worker model key; WORKER_MODEL is ignored.
ROUTER_ASSISTANT_ENABLED=false
MIDDLEWARE_ENABLED=false
SAFETY_OPEN=true
DISABLE_SAFETY_GATE=false

# OPTIONAL: defaults to BRAIN_MODEL and must support image input when uploads are used.
# VISION_MODEL=replace-with-vision-model

# OPTIONAL: Telegram. Both values are required when this interface is enabled.
# TELEGRAM_BOT_TOKEN=replace-with-bot-token
# TELEGRAM_CHAT_ID=replace-with-numeric-chat-id

# OPTIONAL: remote API. Set a long random value before exposing Ciel beyond localhost.
# CIEL_API_TOKEN=replace-with-long-random-token

# RECOMMENDED in headless Docker: disables live screen/mouse tools only.
# Uploaded image files remain available through image_file_ops.
# DISABLED_SKILL_MODULES=vision_ops

# OPTIONAL and off by default. Select named triggers explicitly when enabling.
# PROACTIVE_ENABLED=false
# PROACTIVE_TRIGGERS=
